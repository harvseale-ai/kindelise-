# Safe placeholders only. Copy to .env and replace every replace_me value.
DJANGO_SECRET_KEY=replace_me_with_a_long_random_value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Heroku supplies DATABASE_URL. Local development may use the POSTGRES_* values.
DATABASE_URL=
POSTGRES_DB=kindlelise
POSTGRES_USER=kindlelise
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_ID=replace_me

OLLAMA_API_URL=
OLLAMA_API_KEY=replace_me
OLLAMA_MODEL=replace_me_with_one_pinned_model
OLLAMA_TIMEOUT_SECONDS=10
