# WHY: Provides safe placeholders that can be copied locally without committing real passwords or private keys.
DJANGO_SECRET_KEY=replace_me_with_a_long_random_value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# KEYWORD: DATABASE_URL — one private address containing all details needed to reach the hosted database.
# WHY: Lets Heroku supply one database address while local development can use the separate POSTGRES values.
DATABASE_URL=
POSTGRES_DB=kindlelise
POSTGRES_USER=kindlelise
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# WHY: Keeps payment credentials outside saved code and separates the account key, signed notices, and yearly price.
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_ID=replace_me

# WHY: Keeps the wording service address, private key, chosen model, and time limit changeable without editing code.
OLLAMA_API_URL=https://ollama.com/api/generate
OLLAMA_API_KEY=replace_me
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_SECONDS=10
